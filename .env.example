# Local application settings
DOMAIN=localhost
FRONTEND_HOST=http://localhost:5173
ENVIRONMENT=local
PROJECT_NAME="Smart Notes AI"
STACK_NAME=smart-notes-ai
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:5173

# Use unique values locally and never commit the real .env file.
SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Database
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=smart_notes
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis

# Optional integrations
GROQ_API_KEY=
COHERE_API_KEY=
SENTRY_DSN=

# Optional email configuration
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_PORT=587
SMTP_TLS=true
SMTP_SSL=false
EMAILS_FROM_EMAIL=

# Docker image names used by Docker Compose
DOCKER_IMAGE_BACKEND=smart-notes-backend
DOCKER_IMAGE_FRONTEND=smart-notes-frontend
